[flake8]
# 最大行长 120，与 Black 兼容
max-line-length = 120
extend-ignore = E203, W503, E501

# 排除目录
exclude =
    .godot,
    .import,
    builds,
    dist,
    __pycache__,
    .venv,
    venv,
    .git,
    .github

# 忽略特定错误
per-file-ignores =
    __init__.py: F401

# 最大复杂度（可选，防止函数过长）
max-complexity = 10
