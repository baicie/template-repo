{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["enemies"],
  "properties": {
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "max_hp", "region", "moves"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "敌人 ID，必须为 snake_case"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "敌人显示名称"
          },
          "max_hp": {
            "type": "integer",
            "minimum": 1,
            "description": "最大生命值"
          },
          "region": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "难度区域：1=简单，2=中等，3=困难"
          },
          "moves": {
            "type": "array",
            "minItems": 1,
            "description": "敌人行动列表"
          }
        }
      }
    }
  }
}
